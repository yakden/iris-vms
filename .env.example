# Iris runtime configuration (the installer writes this automatically).
# Copy to .env only if you deploy manually. Values shown are the public
# distribution defaults: license-clean models + detection-only (biometrics off).

# --- Auth (behind your own reverse proxy / SSO in production) ---
AUTH_REQUIRED=false

# --- Edition: license-clean + detection-only (legally-clean public default) ---
# RT-DETR (Apache-2.0) detector instead of AGPL YOLOv8n; no research-only weights.
MODEL_LICENSE_CLEAN=true
# Detection-only: face recognition, face-anchored identities and age/gender are OFF.
# Opt in to biometrics ONLY with your own legal basis + commercial face-model licence.
BIOMETRICS_ENABLED=false

# --- Device (installer sets cpu/cuda from detected hardware) ---
DETECTOR_DEVICE=cpu
IRIS_IMAGE_TAG=1.60.0-cpu

# --- Clean-model sources (Apache-2.0). Provisioned on first run. ---
RTDETR_ONNX_URL=https://iris.monmyip.io/downloads/rtdetr.onnx

# --- Licence verification (vendor PUBLIC key — verify-only, safe to ship) ---
IRIS_LICENSE_PUBKEY_
IRIS_LICENSE_PUBKEY_E=65537

# --- Free 7-day online trial + signed updates ---
TRIAL_AUTO_ENABLED=true
TRIAL_SERVER_URL=https://account.iris.monmyip.io
UPDATE_CHECK_ENABLED=true
UPDATE_SERVER_URL=https://updates.iris.monmyip.io
UPDATE_CHANNEL=stable
